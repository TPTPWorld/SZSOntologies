    ! [A: $i > $o,C: $i > $o] :
      ( ( ( ( ? [I1: $i] : (A @ I1) ) & ( ? [I1: $i] : ~ (A @ I1) ) ) & ( ! [I1: $i] : ~ (C @ I1) ) ) => ( ( ? [I1: $i] : (A @ I1) ) & ( ! [I1: $i] : ~ (C @ I1) ) ) ) ).

