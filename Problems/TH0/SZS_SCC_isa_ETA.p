thf(fin_type,type,
    fin: $i > $o ).

%----There is a finite interpretation
thf(fin_nonempty,axiom,
    ( ? [I1: $i] : (fin @ I1) ) ).

%----SatisfiableCounterConclusionContradictoryAxioms isa EquiTautologous
thf(isa_scc_eta,conjecture,
    ! [A: $i > $o,C: $i > $o] :
      ( ( ~ ( ? [I1: $i] : (A @ I1) ) & ( ? [I1: $i] : ~ (C @ I1) ) ) => ( ( ! [I1: $i] : (A @ I1) ) <=> ( ! [I1: $i] : (C @ I1) ) ) ) ).

