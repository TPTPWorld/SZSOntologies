thf(fin_type,type,
    fin: $i > $o ).

%----There is a finite interpretation
thf(fin_nonempty,axiom,
    ( ? [I1: $i] : (fin @ I1) ) ).

%----FinitelySatisfiable isa Satisfiable
thf(isa_fsa_sat,conjecture,
    ! [A: $i > $o,C: $i > $o] :
      ( ( ( ? [I1: $i] : ( (A @ I1) & (fin @ I1) ) ) & ( ? [I1: $i] : ( ( (A @ I1) & (C @ I1) ) & (fin @ I1) ) ) ) => ( ( ? [I1: $i] : (A @ I1) ) & ( ? [I1: $i] : ( (A @ I1) & (C @ I1) ) ) ) ) ).

