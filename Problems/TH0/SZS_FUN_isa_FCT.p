thf(fin_type,type,
    fin: $i > $o ).

%----There is a finite interpretation
thf(fin_nonempty,axiom,
    ( ? [I1: $i] : (fin @ I1) ) ).

%----FinitelyUnsatisfiable isa FiniteCounterTheorem
thf(isa_fun_fct,conjecture,
    ! [A: $i > $o,C: $i > $o] :
      ( ( ( ! [I1: $i] : ( (fin @ I1) => (A @ I1) ) ) & ( ! [I1: $i] : ( (fin @ I1) => ~ (C @ I1) ) ) ) => ( ! [I1: $i] : ( ( (A @ I1) & (fin @ I1) ) => ~ (C @ I1) ) ) ) ).

