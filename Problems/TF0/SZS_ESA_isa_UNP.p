tff(interp_type,type,
    interp: $tType ).

tff(a_type,type,
    a: interp > $o ).

tff(c_type,type,
    c: interp > $o ).

tff(fin_type,type,
    fin: interp > $o ).

%----There is a finite interpretation
tff(fin_nonempty,axiom,
    ( ? [I1: interp] : fin(I1) ) ).

%----EquiSatisfiable isa UnsatisfiabilityPreserving
tff(isa_esa_unp,conjecture,
    ( ( ~ ( ? [I1: interp] : a(I1) ) <=> ~ ( ? [I1: interp] : c(I1) ) ) => ( ~ ( ? [I1: interp] : a(I1) ) => ~ ( ? [I1: interp] : c(I1) ) ) ) ).

