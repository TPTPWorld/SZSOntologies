    ( ( ( ! [I1: interp] : ( fin(I1) => a(I1) ) ) & ( ! [I1: interp] : ( fin(I1) => ~ c(I1) ) ) ) => ( ! [I1: interp] : ( ( a(I1) & fin(I1) ) => ~ c(I1) ) ) ) ).

